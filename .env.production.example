APP_NAME=Watermelon
APP_ENV=production
APP_KEY=base64:jR8AsVrH3ymV/6aiAiA5NREumdZAWNCJdShHf6fS/2M=
APP_DEBUG=false
APP_URL=https://helmykurniawan.my.id
FRONTEND_URL=https://helmykurniawan.my.id

# Must match the real domain the frontend is served from (no scheme, no port
# unless the frontend is on a non-standard one).
SANCTUM_STATEFUL_DOMAINS=helmykurniawan.my.id
SESSION_DOMAIN=helmykurniawan.my.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# DB_HOST must be the docker-compose service name ("db"), not 127.0.0.1 —
# the app container reaches the db container over the "watermelon" network.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=watermelon
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI API keys are user-managed in-app (Settings -> AI API Keys) — none needed here.
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile
